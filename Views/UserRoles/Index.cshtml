@model IEnumerable<AssignmentProg.Models.ViewModels.UserRolesViewModel>

@{
    ViewData["Title"] = "User Roles Management";
}

<div class="container mt-4">
    <h2>User Roles Management</h2>
    <p>View registered users and manage their assigned roles.</p>

    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-info">
                <tr>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Roles</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.UserName</td>
                            <td>@string.Join(", ", user.Roles)</td>
                            <td>
                                <a asp-controller="UserRoles"
                                   asp-action="Manage"
                                   asp-route-userId="@user.UserId"
                                   class="btn btn-primary btn-sm">
                                    Manage Roles
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            No registered users found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>