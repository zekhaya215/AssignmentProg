@model List<AssignmentProg.Models.ViewModels.ManageUserRolesViewModel>

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container mt-4">
    <h2>Manage Roles for: <strong>@ViewBag.UserName</strong></h2>

    <hr />

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-controller="UserRoles"
          asp-action="Manage"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="userId" value="@ViewBag.UserId" />

        <div class="card">
            <div class="card-header">
                Assign or Remove Roles
            </div>

            <div class="card-body">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="form-check mt-2">
                        <input type="hidden"
                               asp-for="@Model[i].RoleId" />

                        <input type="hidden"
                               asp-for="@Model[i].RoleName" />

                        <input asp-for="@Model[i].IsSelected"
                               class="form-check-input" />

                        <label asp-for="@Model[i].IsSelected"
                               class="form-check-label">
                            @Model[i].RoleName
                        </label>
                    </div>
                }
            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    Update Roles
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Users
                </a>
            </div>
        </div>
    </form>
</div>